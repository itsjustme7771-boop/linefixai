# ── Frontend (copy this file to .env) ──────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe (Dashboard → Developers → API keys)
# Use TEST keys while developing. Leave blank to disable checkout UI.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Only needed if you use Stripe Connect (the builder wired this up)
VITE_STRIPE_ACCOUNT_ID=

# ── Supabase Edge Function secrets (set via Supabase CLI, NOT in .env) ───────
# supabase secrets set OPENAI_API_KEY=sk-...
# supabase secrets set STRIPE_SECRET_KEY=sk_test_...
# supabase secrets set STRIPE_ACCOUNT_ID=acct_...
# supabase secrets set STRIPE_PRICE_BASIC=price_...
# supabase secrets set STRIPE_PRICE_ADVANCED=price_...
# supabase secrets set STRIPE_PRICE_PREMIUM=price_...